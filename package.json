{
	"name": "fastmail-mcp-remote",
	"version": "1.13.0",
	"description": "Remote MCP server and CLI for Fastmail on Cloudflare Workers with Cloudflare Access OAuth",
	"private": true,
	"bin": {
		"fastmail": "./cli/bin.sh"
	},
	"scripts": {
		"predeploy": "tsx tools/validate-wrangler-config.ts",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cli": "tsx cli/main.ts",
		"cf-typegen": "wrangler types",
		"type-check": "wrangler types && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cloudflare/codemode": "^0.5.1",
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@modelcontextprotocol/server": "2.0.0",
		"agents": "^0.20.1",
		"commander": "^14.0.3",
		"hono": "^4.12.8",
		"just-pick": "^4.2.0",
		"linkedom": "^0.18.12",
		"marked": "^17.0.4",
		"open": "^11.0.0",
		"tsx": "^4.21.0",
		"turndown": "^7.2.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@types/node": "^25.5.0",
		"@types/turndown": "^5.0.6",
		"ai": "^6.0.68",
		"prettier": "^3.8.1",
		"typescript": "5.9.3",
		"vitest": "^4.0.18",
		"wrangler": "^4.75.0"
	}
}
